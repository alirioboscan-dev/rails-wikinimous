<div class="container my-4">
  <h1><%= @article.title %></h1>
  <p><%= simple_format @article.content %></p>
  <div class="mt-4">
    <%= link_to "Editar", edit_article_path(@article), class: "btn btn-secondary me-2" %>
    <%= link_to "Volver", articles_path, class: "btn btn-outline-secondary" %>
  </div>
</div>
