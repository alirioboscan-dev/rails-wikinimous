<div class="container my-4">
  <div class="d-flex justify-content-between align-items-center mb-4">
    <h1>Wiki</h1>
    <%= link_to "Nuevo artículo", new_article_path, class: "btn btn-primary" %>
  </div>

  <% @articles.each do |article| %>
    <div class="card mb-3">
      <div class="card-body d-flex justify-content-between align-items-center">
        <%= link_to article.title, article_path(article), class: "h5 mb-0 text-decoration-none" %>
        <div>
          <%= link_to "Editar", edit_article_path(article), class: "btn btn-sm btn-outline-secondary me-2" %>
          <%= link_to "Eliminar", article_path(article), data: { turbo_method: :delete, turbo_confirm: "¿Estás seguro?" }, class: "btn btn-sm btn-outline-danger" %>
        </div>
      </div>
    </div>
  <% end %>
</div>
